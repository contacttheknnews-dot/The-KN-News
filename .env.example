# The KN News — environment variables
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (the .env file is NOT deployed).

# --- Database (REQUIRED) ---
# Use the POOLED Neon endpoint (host contains `-pooler`) for the app on Vercel,
# with pgbouncer + a low connection_limit so serverless lambdas don't exhaust
# the connection cap.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) endpoint — used ONLY by prisma migrate / db push.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Auth (REQUIRED in production) ---
# Generate a strong secret:  openssl rand -base64 32
# Production refuses to start without this.
AUTH_SECRET=""

# --- Seed password (REQUIRED only when running `npm run db:seed`) ---
# Min 12 characters. The seed has NO default password and will refuse to run
# without this. Never use a shared/guessable value.
SEED_ADMIN_PASSWORD=""

# --- Site URL (REQUIRED in production) ---
# Used for canonical URLs, sitemaps, Open Graph, JSON-LD.
NEXT_PUBLIC_SITE_URL="http://theknnews.in"

# --- Email notifications (newsletter, contact, ad enquiries) ---
# Gmail: host smtp.gmail.com, port 465, user = the Gmail address,
# pass = 16-character App Password (Google Account → Security → App passwords).
NOTIFY_EMAIL="contacttheknnews@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-char-app-password"

# --- Google AdSense (optional — leave empty until account approved) ---
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""
NEXT_PUBLIC_ADSENSE_AUTO_ADS="false"

# --- Google Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Vercel Blob (image uploads) ---
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
