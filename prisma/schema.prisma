// The KN News — database schema (PostgreSQL / Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // When you move the app to the POOLED Neon endpoint, uncomment the line below
  // and set DIRECT_DATABASE_URL (the non-pooled endpoint) so migrate/db push use
  // a direct connection. Leaving it commented keeps `prisma generate` working
  // when only DATABASE_URL is set.
  // directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String
  passwordHash String
  // SUPER_ADMIN | EDITOR | REPORTER | AUTHOR | AD_MANAGER | MODERATOR
  role         String        @default("EDITOR")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  activityLogs ActivityLog[]
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Author {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  photo       String?
  bio         String?
  designation String?
  email       String?
  facebook    String?
  twitter     String?
  instagram   String?
  articles    Article[]
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String // Hindi display name
  nameEn      String? // English name (used in slugs/labels)
  slug        String     @unique
  description String?
  order       Int        @default(0)
  showInNav   Boolean    @default(true)
  parentId    Int?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("Subcategories")
  articles    Article[]  @relation("ArticleCategory")
  subArticles Article[]  @relation("ArticleSubcategory")
  videos      Video[]
  galleries   Gallery[]

  @@index([parentId])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id              Int          @id @default(autoincrement())
  title           String
  slug            String       @unique
  subheadline     String?
  excerpt         String
  body            String // HTML body produced by the editor
  image           String
  imageCaption    String?
  categoryId      Int
  category        Category     @relation("ArticleCategory", fields: [categoryId], references: [id])
  subcategoryId   Int?
  subcategory     Category?    @relation("ArticleSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  authorId        Int
  author          Author       @relation(fields: [authorId], references: [id])
  location        String?
  // DRAFT | PUBLISHED | SCHEDULED
  status          String       @default("DRAFT")
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  views           Int          @default(0)
  featured        Boolean      @default(false)
  isOpinion       Boolean      @default(false)
  seoTitle        String?
  metaDescription String?
  focusKeyword    String?
  canonicalUrl    String?
  socialImage     String?
  editorNotes     String? // internal notes, never rendered publicly
  tags            ArticleTag[]
  comments        Comment[]
  revisions       ArticleRevision[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([authorId])
  @@index([status, views(sort: Desc)])
  @@index([featured, status])
}

// Snapshot of an article before each significant edit (restore-able).
model ArticleRevision {
  id          Int      @id @default(autoincrement())
  articleId   Int
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title       String
  subheadline String?
  excerpt     String
  body        String
  savedBy     String? // user name at save time (denormalized)
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt])
}

model ArticleTag {
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  articleId Int
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")
  name      String
  body      String
  likes     Int       @default(0)
  reported  Boolean   @default(false)
  // PENDING | APPROVED | REJECTED
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())

  @@index([articleId, status])
  @@index([parentId])
}

model BreakingNews {
  id        Int       @id @default(autoincrement())
  text      String
  link      String?
  active    Boolean   @default(true)
  order     Int       @default(0)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
}

model Advertisement {
  id             Int       @id @default(autoincrement())
  advertiserName String
  imageDesktop   String
  imageMobile    String?
  url            String
  // HEADER | BELOW_NAV | HOME_MID_1 | HOME_MID_2 | HOME_MID_3 | SIDEBAR |
  // ARTICLE_TOP | ARTICLE_MID | ARTICLE_BOTTOM | CATEGORY | BEFORE_FOOTER
  placement      String
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean   @default(true)
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([placement, active])
}

model Video {
  id          Int       @id @default(autoincrement())
  title       String
  youtubeId   String
  thumbnail   String?
  duration    String?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt DateTime  @default(now())
  views       Int       @default(0)

  @@index([categoryId])
}

model Gallery {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  categoryId  Int?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt DateTime       @default(now())
  images      GalleryImage[]

  @@index([categoryId])
}

model GalleryImage {
  id        Int     @id @default(autoincrement())
  galleryId Int
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  image     String
  caption   String?
  order     Int     @default(0)

  @@index([galleryId])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdInquiry {
  id          Int      @id @default(autoincrement())
  name        String
  company     String?
  email       String
  phone       String?
  requirement String?
  budget      String?
  message     String?
  // NEW | CONTACTED | CLOSED
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
